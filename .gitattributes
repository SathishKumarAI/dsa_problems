# Normalise line endings so a Windows and a Linux checkout produce the same bytes.
#
# Without this, regenerating docs/learn/** on Windows leaves `git status` showing 128
# modified files whose content is byte-identical — `git diff --exit-code` returns 0 and
# md5 matches, but status still reports M. That noise hides real drift, and the CI job
# that checks `docs/learn` is regenerated would be reading a different signal on each
# platform. It cost real confusion on 2026-09-13.

* text=auto eol=lf

# Generated content — collapse it in diffs and exclude it from language stats.
# It is regenerated by `npm run docs:learn`; never hand-edit it.
docs/learn/**      linguist-generated=true

# Read-only reference, kept for history. Not built, not linted, not ours to count.
legacy/**          linguist-vendored=true

# Binary, so git never tries to merge or normalise them.
*.png              binary
*.jpg              binary
*.jpeg             binary
*.gif              binary
*.webp             binary
*.ico              binary
*.woff             binary
*.woff2            binary
*.pdf              binary
